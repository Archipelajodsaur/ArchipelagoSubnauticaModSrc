<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Configurations>Debug;Release</Configurations>
    <LangVersion>latestmajor</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Override these properties to use an installed game instead of local staging. -->
    <LocalDependenciesDir Condition="'$(LocalDependenciesDir)' == ''">$(MSBuildProjectDirectory)/../.local-dependencies</LocalDependenciesDir>
    <SubnauticaManagedDir Condition="'$(SubnauticaManagedDir)' == ''">$(LocalDependenciesDir)/managed</SubnauticaManagedDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(LocalDependenciesDir)/bepinex/core</BepInExCoreDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)/0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SubnauticaManagedDir)/Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(SubnauticaManagedDir)/Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)/BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Harmony">
      <HintPath>$(BepInExCoreDir)/BepInEx.Harmony.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Preloader">
      <HintPath>$(BepInExCoreDir)/BepInEx.Preloader.dll</HintPath>
    </Reference>
    <Reference Include="PlatformIODefault">
      <HintPath>$(SubnauticaManagedDir)/PlatformIODefault.dll</HintPath>
    </Reference>
    <Reference Include="Unity.Addressables">
      <HintPath>$(SubnauticaManagedDir)/Unity.Addressables.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SubnauticaManagedDir)/UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SubnauticaManagedDir)/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(SubnauticaManagedDir)/UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(SubnauticaManagedDir)/UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(SubnauticaManagedDir)/UnityEngine.UI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
  </ItemGroup>

  <ItemGroup>
    <RequiredBuildDependency Include="$(BepInExCoreDir)/0Harmony.dll" />
    <RequiredBuildDependency Include="$(BepInExCoreDir)/BepInEx.dll" />
    <RequiredBuildDependency Include="$(BepInExCoreDir)/BepInEx.Harmony.dll" />
    <RequiredBuildDependency Include="$(BepInExCoreDir)/BepInEx.Preloader.dll" />
    <RequiredBuildDependency Include="$(SubnauticaManagedDir)/Assembly-CSharp.dll" />
    <RequiredBuildDependency Include="$(SubnauticaManagedDir)/Assembly-CSharp-firstpass.dll" />
    <RequiredBuildDependency Include="$(SubnauticaManagedDir)/PlatformIODefault.dll" />
    <RequiredBuildDependency Include="$(SubnauticaManagedDir)/Unity.Addressables.dll" />
    <RequiredBuildDependency Include="$(SubnauticaManagedDir)/UnityEngine.dll" />
    <RequiredBuildDependency Include="$(SubnauticaManagedDir)/UnityEngine.CoreModule.dll" />
    <RequiredBuildDependency Include="$(SubnauticaManagedDir)/UnityEngine.IMGUIModule.dll" />
    <RequiredBuildDependency Include="$(SubnauticaManagedDir)/UnityEngine.InputLegacyModule.dll" />
    <RequiredBuildDependency Include="$(SubnauticaManagedDir)/UnityEngine.UI.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="mod.json" />
  </ItemGroup>

  <Target Name="ValidateBuildDependencies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('%(RequiredBuildDependency.Identity)')"
           Text="Missing build dependency: %(RequiredBuildDependency.Identity). Run scripts/setup-local-deps.sh with a Managed.zip archive, or override SubnauticaManagedDir and BepInExCoreDir." />
  </Target>

  <Target Name="InstallToGame" AfterTargets="Build" Condition="'$(ModInstallDir)' != ''">
    <MakeDir Directories="$(ModInstallDir)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)Archipelago.MultiClient.Net.dll"
          DestinationFolder="$(ModInstallDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
